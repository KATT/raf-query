{
	"name": "raf-query-workspace",
	"private": true,
	"description": "Workspace root for raf-query",
	"type": "module",
	"scripts": {
		"build": "pnpm -r --filter \"./packages/*\" build",
		"format": "vp fmt",
		"format:check": "vp fmt --check",
		"lint": "vp lint -c .oxlintrc.json --disable-nested-config",
		"lint:fix": "vp lint -c .oxlintrc.json --fix --disable-nested-config",
		"prepare": "husky",
		"test": "pnpm -r --filter \"./packages/*\" test",
		"typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
		"check": "vp check",
		"postinstall": "vendor-src check"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:",
		"@release-it/conventional-changelog": "12.0.2",
		"@tanstack/react-query": "5.104.1",
		"@tanstack/react-router": "1.170.42",
		"@types/node": "26.6.4",
		"@vitest/coverage-v8": "5.0.1",
		"effect": "catalog:",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"oxfmt": "0.70.0",
		"oxlint": "1.85.0",
		"release-it": "21.1.0",
		"typescript": "7.0.2",
		"vendor-src": "0.15.2",
		"vite-plus": "1.0.0"
	},
	"lint-staged": {
		"*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "vp lint -c .oxlintrc.json --fix --disable-nested-config --no-error-on-unmatched-pattern",
		"*": "vp fmt --no-error-on-unmatched-pattern"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.9.1"
}
