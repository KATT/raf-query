{
	"name": "raf-query-workspace",
	"private": true,
	"description": "Workspace root for raf-query",
	"type": "module",
	"scripts": {
		"build": "pnpm -r --filter \"./packages/*\" build",
		"format": "vp fmt",
		"format:check": "vp fmt --check",
		"lint": "oxlint --disable-nested-config",
		"lint:fix": "oxlint --fix --disable-nested-config",
		"prepare": "husky",
		"test": "pnpm -r --filter \"./packages/*\" --filter \"./tooling/*\" test",
		"typecheck": "pnpm -r --filter \"./packages/*\" --filter \"./tooling/*\" typecheck",
		"check": "vp check",
		"postinstall": "vendor-src check"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:",
		"@release-it/conventional-changelog": "12.0.2",
		"@tanstack/react-query": "5.104.1",
		"@tanstack/react-router": "1.170.42",
		"@tooling/oxlint-plugins": "workspace:*",
		"@types/node": "26.6.4",
		"@vitest/coverage-v8": "5.0.1",
		"effect": "catalog:",
		"eslint-plugin-no-only-tests": "3.4.0",
		"eslint-plugin-perfectionist": "5.12.1",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"oxfmt": "0.70.0",
		"oxlint": "1.85.0",
		"oxlint-tsgolint": "7.0.2003",
		"release-it": "21.1.0",
		"typescript": "7.0.2",
		"vendor-src": "0.15.2",
		"vite-plus": "1.0.0"
	},
	"lint-staged": {
		"*": "vp fmt --no-error-on-unmatched-pattern"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.9.1"
}
