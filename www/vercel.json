{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "pnpm build",
	"framework": "tanstack-start",
	"ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ../packages ../examples/.shared/ui ../package.json ../pnpm-lock.yaml",
	"installCommand": "pnpm install --frozen-lockfile"
}
