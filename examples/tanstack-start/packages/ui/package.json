{
	"name": "@examples/ui",
	"version": "0.0.0",
	"private": true,
	"description": "shadcn/ui components shared by the example apps",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		"./globals.css": "./src/styles/globals.css",
		"./components/*": "./src/components/*.tsx",
		"./hooks/*": "./src/hooks/*.ts",
		"./lib/*": "./src/lib/*.ts"
	},
	"scripts": {
		"typecheck": "tsc"
	},
	"dependencies": {
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "1.55.0",
		"radix-ui": "1.8.0",
		"sonner": "2.0.8",
		"tailwind-merge": "3.7.0",
		"tw-animate-css": "1.4.0"
	},
	"devDependencies": {
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	}
}
