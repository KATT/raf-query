{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "pnpm build",
	"framework": "nextjs",
	"ignoreCommand": "pnpm install --frozen-lockfile --filter @tooling/vercel-ignore || exit 1; node ../../tooling/vercel-ignore/src/bin/ignore.ts",
	"installCommand": "pnpm install --frozen-lockfile"
}
