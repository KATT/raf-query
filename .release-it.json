{
	"git": {
		"commitMessage": "chore: release v${version}",
		"commitsPath": "packages/core packages/react",
		"pushArgs": ["--follow-tags", "--atomic"],
		"requireCommits": true
	},
	"github": {
		"release": true,
		"releaseName": "v${version}"
	},
	"hooks": {
		"after:bump": "pnpm -r --filter \"./packages/*\" exec npm pkg set version=${version}",
		"before:git:release": "pnpm build && git fetch -q origin main && { test \"$(git rev-parse FETCH_HEAD)\" = \"$(git rev-parse HEAD)\" || { echo 'main moved during this release; the newer run releases it.'; exit 1; }; } && pnpm --filter @raf-query/core run publish:npm && pnpm --filter @raf-query/react run publish:npm"
	},
	"npm": false,
	"plugins": {
		"@release-it/conventional-changelog": {
			"infile": "CHANGELOG.md",
			"preset": {
				"name": "conventionalcommits",
				"preMajor": true,
				"types": [
					{
						"section": "Features",
						"type": "feat"
					},
					{
						"section": "Bug Fixes",
						"type": "fix"
					},
					{
						"section": "Performance Improvements",
						"type": "perf"
					},
					{
						"hidden": true,
						"type": "build"
					},
					{
						"hidden": true,
						"type": "chore"
					},
					{
						"hidden": true,
						"type": "ci"
					},
					{
						"hidden": true,
						"type": "docs"
					},
					{
						"hidden": true,
						"type": "refactor"
					},
					{
						"hidden": true,
						"type": "style"
					},
					{
						"hidden": true,
						"type": "test"
					}
				]
			}
		}
	}
}
