{
	"name": "@examples/experimental-svelte-app",
	"version": "0.0.0",
	"private": true,
	"description": "Experiment: the raf-query issue tracker on SvelteKit, built on @raf-query/experimental-svelte and shadcn-svelte",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "vp build",
		"dev": "vp dev --port 3007",
		"prepare": "svelte-kit sync",
		"start": "PORT=3007 node build/index.js",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
	},
	"dependencies": {
		"@examples/api": "workspace:*",
		"@examples/db": "workspace:*",
		"@examples/kit": "workspace:*",
		"@examples/ui": "workspace:*",
		"@raf-query/experimental-svelte": "workspace:*",
		"svelte": "5.57.2"
	},
	"devDependencies": {
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.58.0",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.4",
		"bits-ui": "2.19.5",
		"clsx": "2.1.1",
		"mode-watcher": "1.1.0",
		"svelte-check": "4.7.7",
		"svelte-sonner": "1.2.1",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.3.4",
		"vite-plus": "1.0.0"
	}
}
