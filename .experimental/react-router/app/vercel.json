{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "pnpm build",
	"framework": "react-router",
	"ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ../.shared ../../packages ../../package.json ../../pnpm-lock.yaml || exit 1",
	"installCommand": "pnpm install --frozen-lockfile"
}
