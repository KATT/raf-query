{
	"name": "@examples/experimental-effect-atom",
	"version": "0.0.0",
	"private": true,
	"description": "Experiment: an interactive demo of typed error boundaries over effect/reactivity atoms and an in-browser Effect RPC API",
	"type": "module",
	"exports": {
		"./live": "./src/live.tsx"
	},
	"scripts": {
		"build": "node scripts/type-levels.ts --check && vp build",
		"dev": "vp dev --port 3011",
		"start": "vp preview --port 3011",
		"type-errors": "node scripts/type-errors.ts",
		"type-levels": "node scripts/type-levels.ts",
		"typecheck": "tsc && node scripts/type-errors.ts --check && node scripts/type-levels.ts --check"
	},
	"dependencies": {
		"@effect/atom-react": "catalog:",
		"@examples/ui": "workspace:*",
		"@raf-query/experimental-effect-atom": "workspace:*",
		"cn": "0.4.0",
		"effect": "catalog:",
		"lucide-react": "1.55.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"scheduler": "0.28.0"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"typescript6": "npm:typescript@6.0.3",
		"vite": "8.3.4",
		"vite-plus": "1.0.0"
	}
}
