{
	"name": "@raf-query/svelte",
	"version": "0.10.0",
	"description": "Svelte bindings for raf-query, a render-as-you-fetch query library",
	"keywords": [
		"query",
		"raf",
		"render-as-you-fetch",
		"svelte",
		"sveltekit"
	],
	"license": "MIT",
	"author": {
		"name": "KATT",
		"email": "alexander@n1s.se"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KATT/raf-query.git",
		"directory": "packages/svelte"
	},
	"homepage": "https://raf-query.katt.dev",
	"bugs": {
		"url": "https://github.com/KATT/raf-query/issues"
	},
	"files": [
		"dist/",
		"CHANGELOG.md",
		"LICENSE.md",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"prepack": "node ../../scripts/sync-package-docs.ts",
		"build": "svelte-package --input src --output dist",
		"test": "vp test",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"publish:npm": "pnpm pack --out package.tgz && npm publish package.tgz --access public && rm package.tgz"
	},
	"dependencies": {
		"@raf-query/core": "workspace:*"
	},
	"peerDependencies": {
		"effect": "^4.0.0",
		"svelte": "^5.7.0"
	},
	"devDependencies": {
		"@sveltejs/package": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@testing-library/svelte": "5.4.2",
		"@types/node": "26.6.4",
		"@vitest/coverage-v8": "5.0.1",
		"effect": "catalog:",
		"happy-dom": "21.0.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"vite-plus": "1.0.0"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"svelte": "./dist/index.js",
				"default": "./dist/index.js"
			}
		},
		"provenance": true
	},
	"engines": {
		"node": ">=22"
	}
}
