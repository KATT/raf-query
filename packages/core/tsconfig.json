{
	"compilerOptions": {
		"declaration": true,
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"paths": {
			"@raf-query/react": ["../react/src/index.ts"],
			"@raf-query/react/devtools": ["../react/src/devtools.tsx"]
		},
		"resolveJsonModule": true,
		"rewriteRelativeImportExtensions": true,
		"skipLibCheck": true,
		"strict": true,
		"lib": ["ES2024", "ESNext.Disposable", "DOM", "DOM.Iterable"],
		"target": "ES2024",
		"types": ["node"]
	},
	"include": ["src", "scripts", "vitest.setup.ts"],
	"exclude": [".repos", "dist", "node_modules", "coverage"]
}
