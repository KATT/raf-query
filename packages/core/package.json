{
	"name": "@raf-query/core",
	"version": "0.11.1",
	"description": "Framework-agnostic core of raf-query, a render-as-you-fetch query library",
	"keywords": [
		"query",
		"raf",
		"render-as-you-fetch",
		"suspense"
	],
	"license": "MIT",
	"author": {
		"name": "KATT",
		"email": "alexander@n1s.se"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KATT/raf-query.git",
		"directory": "packages/core"
	},
	"homepage": "https://raf-query.katt.dev",
	"bugs": {
		"url": "https://github.com/KATT/raf-query/issues"
	},
	"files": [
		"dist/",
		"CHANGELOG.md",
		"LICENSE.md",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./hydration": "./src/hydration.ts",
		"./internal": "./src/internal.ts"
	},
	"scripts": {
		"prepack": "node ../../scripts/sync-package-docs.ts",
		"build": "vp pack",
		"test": "vp test",
		"typecheck": "tsc",
		"publish:npm": "pnpm pack --out package.tgz && npm publish package.tgz --access public && rm package.tgz"
	},
	"devDependencies": {
		"@types/node": "26.6.4",
		"@vitest/coverage-v8": "5.0.1",
		"typescript": "7.0.2",
		"vite-plus": "1.0.0",
		"fast-check": "catalog:"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/index.mjs",
			"./hydration": "./dist/hydration.mjs",
			"./internal": "./dist/internal.mjs"
		},
		"provenance": true
	},
	"engines": {
		"node": ">=22"
	}
}
